<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HistoricoActivity">

    <TextView
        android:id="@+id/historico_de_vitorias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Histórico de Vitórias"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pontuacao_nos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:text="Nós: "
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/historico_de_vitorias" />

    <TextView
        android:id="@+id/pontuacao_eles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Eles:"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/pontuacao_nos"
        app:layout_constraintTop_toBottomOf="@+id/pontuacao_nos" />

    <TextView
        android:id="@+id/placar_nos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="0"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/pontuacao_nos"
        app:layout_constraintStart_toEndOf="@+id/pontuacao_nos"
        app:layout_constraintTop_toTopOf="@+id/pontuacao_nos"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/placar_eles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/pontuacao_eles"
        app:layout_constraintEnd_toEndOf="@+id/placar_nos"
        app:layout_constraintStart_toStartOf="@+id/placar_nos"
        app:layout_constraintTop_toTopOf="@+id/pontuacao_eles" />
</androidx.constraintlayout.widget.ConstraintLayout>